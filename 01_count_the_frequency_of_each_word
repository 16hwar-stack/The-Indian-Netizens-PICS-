# Program to count the frequency of each word in a given sentence

# Sample input sentence
sentence = "hello world hello python learning python"

# Convert sentence to lowercase so counting is case-insensitive
sentence = sentence.lower()

# Split the sentence into a list of words using space as a separator
words = sentence.split()

# Create an empty dictionary to store word frequencies
word_count = {}

# Loop through each word in the list
for word in words:
  # If the word is already in the dictionary, add 1 to its count
  if word in word_count:
    word_count[word] += 1
  # Otherwise, add the word to the dictionary with a count of 1
  else:
    word_count[word] = 1

# Print the result
print("Sentence:", sentence)
print("Word Frequencies:")
print(word_count)
